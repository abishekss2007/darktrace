{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "indexer": {
      "root": "apps/indexer",
      "runtime": "container"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "indexer",
          "format": "url",
          "env": "INDEXER_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/indexer/(.*)",
      "destination": {
        "service": "indexer"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ]
}
